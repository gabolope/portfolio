# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact form submissions (defaults to gabriellopezmdp@gmail.com).
# While CONTACT_FROM_EMAIL is the onboarding@resend.dev sandbox sender, Resend only
# allows delivery to the email address your Resend account itself is registered under —
# set this to that address until a custom domain is verified below.
CONTACT_TO_EMAIL=

# Verified sender address in Resend (defaults to onboarding@resend.dev, which only
# delivers to the account owner's own email until a custom domain is verified)
CONTACT_FROM_EMAIL=
